{
  "name": "pushguard",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered git pre-push hook for code review",
  "bin": {
    "pushguard": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && npm run copy-prompts",
    "copy-prompts": "node scripts/copy-prompts.js",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "inquirer": "^9.2.15",
    "js-yaml": "^4.1.0",
    "openai": "^4.24.1",
    "@anthropic-ai/sdk": "^0.20.0",
    "@google/genai": "^0.8.0",
    "zod": "^3.22.4",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  },
  "keywords": ["git", "hook", "pre-push", "ai", "code-review"],
  "author": "",
  "license": "MIT",
  "files": ["dist/", "README.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/vasconevesxd/pushguard.git"
  }
}
